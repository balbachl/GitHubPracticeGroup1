@page
@model GitHubPractice.Pages.MembershipPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-danger mb-4">Delete Membership</h1>

<div class="row">
    <div class="col-md-6 bg-light p-4 rounded shadow-sm">
        <div class="alert alert-warning">
            Are you sure you want to delete this membership?
            This action cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Membership.Name)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Membership.Name)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Membership.Email)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Membership.Email)
            </dd>

            <dt class="col-sm-4">Join Date</dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Membership.JoinDate)
            </dd>

            <dt class="col-sm-4">Active Membership</dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Membership.IsActive)
            </dd>
        </dl>

        <form method="post" class="border-top pt-3">
            <input type="hidden" asp-for="Membership.Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>
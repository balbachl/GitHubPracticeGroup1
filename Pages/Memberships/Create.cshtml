@page
@model GitHubPractice.Pages.MembershipPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-primary mb-4">Create Membership</h1>

<div class="row">
    <div class="col-md-6 bg-light p-4 rounded shadow-sm">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Membership.Name" class="control-label"></label>
                <input asp-for="Membership.Name" class="form-control" />
                <span asp-validation-for="Membership.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Membership.Email" class="control-label"></label>
                <input asp-for="Membership.Email" class="form-control" />
                <span asp-validation-for="Membership.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Membership.JoinDate" class="control-label">Join Date</label>
                <input asp-for="Membership.JoinDate" class="form-control" />
                <span asp-validation-for="Membership.JoinDate" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Membership.IsActive" class="form-check-input" />
                <label asp-for="Membership.IsActive" class="form-check-label">
                    Active Membership
                </label>
                <span asp-validation-for="Membership.IsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
